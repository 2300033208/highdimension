# Root Environment Variables for HD-BO Benchmark Platform
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Database Configuration (used by docker-compose)
DB_USER=root
DB_PASS=testpassword

# Email Configuration (Gmail SMTP - used by backend)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=test@gmail.com
MAIL_PASSWORD=testpassword

# JWT Configuration (used by backend)
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
JWT_EXPIRATION_MS=86400000

# LLM Configuration (Ollama or OpenAI-compatible - used by backend)
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1
