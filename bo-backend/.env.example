# Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/bobench?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USER=root
DB_PASS=your_database_password
DB_DDL_AUTO=validate
DB_SHOW_SQL=false

# Email Configuration (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# JWT Configuration
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=your_super_long_jwt_secret_key_at_least_32_bytes
JWT_EXPIRATION_MS=86400000

# LLM Configuration (Ollama or OpenAI-compatible)
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1

# Server Configuration
SERVER_PORT=8081

# File Upload
UPLOAD_DIR=uploads